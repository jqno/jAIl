#!/usr/bin/env bash
# jAIl: run OpenCode for the current project in a rootless Podman microVM.
# Usage: jail [-- opencode-args] | jail shell | jail login | jail build
set -euo pipefail

conf="$HOME/.config/jail"
proxy=http://jail-proxy:8888
base=(
  --rm -it
  --runtime krun --annotation krun.cpus=4 --annotation krun.ram_mib=8192
  --userns=keep-id --cap-drop ALL --security-opt no-new-privileges
  --env-host=false --http-proxy=false
  -e HOME="$HOME" -e TERM="${TERM:-}" -e COLORTERM="${COLORTERM:-}" -e LANG="${LANG:-}"
)

die() {
  echo "jAIl: $*" >&2
  exit 1
}

# Print a list file without comments and blank lines, with a leading ~ expanded.
entries() {
  sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' -e "s|^~|$HOME|" "$1"
}

# Set the names that belong to a profile.
use_profile() {
  profile=$1
  dir="$conf/profiles/$profile"
  net="jail-$profile"
  volume="$net-home"
}

# Print the one profile whose paths match a project; fail if none or several do.
profile_for() {
  local paths name pattern found=() why=()
  for paths in "$conf"/profiles/*/paths; do
    name=$(basename "${paths%/paths}")
    while read -r pattern; do
      # shellcheck disable=SC2053 # the pattern is a glob on purpose
      if [[ $1 == $pattern ]]; then
        found+=("$name")
        why+=("$name ($pattern)")
      fi
    done < <(entries "$paths")
  done
  if ((${#found[@]} != 1)); then die "$1 must match exactly one profile; matches: ${why[*]:-none}"; fi
  echo "${found[0]}"
}

# Start the profile's proxy, reachable as jail-proxy on the profile's internal network.
start_proxy() {
  if ! podman network exists "$net"; then podman network create --internal "$net" >/dev/null; fi
  if ! podman network exists jail-out; then podman network create jail-out >/dev/null; fi
  if ! podman container exists "$net-proxy"; then
    podman create --name "$net-proxy" --network jail-out --network "$net:alias=jail-proxy" \
      -v "$dir/allowlist:/etc/tinyproxy/allowlist:ro,z" \
      --entrypoint tinyproxy jail -d -c /etc/tinyproxy/tinyproxy.conf >/dev/null
  fi
  podman start "$net-proxy" >/dev/null
}

# Print the files in a project whose names are in the masks file.
masked_files() {
  local names=(-false) m
  while read -r m; do names+=(-o -name "$m"); done < <(entries "$conf/masks")
  find "$1" \( -name .git -o -name node_modules \) -prune -o \( "${names[@]}" \) ! -type d -print
}

# Set the current folder, the project (git toplevel, or else the current folder) and its git dir.
find_project() {
  cwd=$(pwd -P)
  proj=$cwd
  gitdir=''
  if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    proj=$(git rev-parse --show-toplevel)
    gitdir=$(git rev-parse --path-format=absolute --git-common-dir)
  fi
}

login() {
  local cwd proj gitdir found
  find_project
  found=$(profile_for "$proj")
  use_profile "$found"
  echo "jAIl: logging in for profile $profile"
  exec podman run "${base[@]}" -v "$volume:$HOME" --entrypoint opencode jail auth login
}

# Rebuild the image from scratch and remove the proxies, so they restart on the new image.
build() {
  local src proxies
  src=$(dirname "$(readlink -f "$0")")/image
  podman build --pull=always --no-cache -t jail "$src"
  mapfile -t proxies < <(podman container ls -a --format '{{.Names}}' | grep -E '^jail-.+-proxy$' || true)
  if ((${#proxies[@]} > 0)); then podman rm -f "${proxies[@]}" >/dev/null; fi
}

run() { # podman run arguments after the options: image and command
  local cwd proj gitdir found masked f args m
  find_project
  found=$(profile_for "$proj")
  use_profile "$found"
  start_proxy
  mapfile -t masked < <(masked_files "$proj")

  args=("${base[@]}" --network "$net" -w "$cwd"
    -v "$volume:$HOME"
    -v "$proj:$proj:z"
    -e http_proxy="$proxy" -e https_proxy="$proxy" -e no_proxy="localhost,127.0.0.1"
    -e JAIL_PROFILE="$profile"
    -e JAIL_HOST_KERNEL="$(uname -r)"
    -e JAIL_GIT_DIR="$gitdir"
    -e JAIL_MASKED="$(printf '%s\n' "${masked[@]}")"
  )
  if [[ -n $gitdir ]]; then args+=(-v "$gitdir:$gitdir:ro,z"); fi
  if [[ -f $proj/.git ]]; then args+=(-v "$proj/.git:$proj/.git:ro,z"); fi
  if [[ -f $dir/mounts ]]; then
    while read -r m; do
      if [[ ! -e $m ]]; then die "$m in $dir/mounts doesn't exist"; fi
      args+=(-v "$m:$m:ro,z")
    done < <(entries "$dir/mounts")
  fi
  if [[ -d $dir/home ]]; then args+=(-v "$dir/home:/jail/home:ro,z"); fi
  for f in "${masked[@]}"; do
    echo "jAIl: masked $f"
    args+=(-v "/dev/null:$f:ro")
  done

  printf '\e]2;jAIl: %s\a' "$profile"
  echo "jAIl: profile $profile, project $proj"
  exec podman run "${args[@]}" "$@"
}

case ${1:-} in
  login) login ;;
  build) build ;;
  shell) run --entrypoint bash jail ;;
  --) run jail opencode "${@:2}" ;;
  *) run jail opencode "$@" ;;
esac
